# Sorbed: model weights and downloaded assets (never commit large binaries)
models/weights/
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
!tests/**/fixtures/**/*.onnx
# Published release weights are committed via Git LFS (see .gitattributes).
!models/release/
!models/release/**/*.onnx
!models/release/**/*.pt

# Sorbed: runtime artifacts and PHI-risk data (NEVER commit patient images)
data/
!data/.gitkeep
outputs/
runs/
*.log
.sorbed_cache/

# Sorbed: generated reports
reports/
!reports/.gitkeep

# Local config overrides
sorbed.local.toml
.secrets
var/

# --- Sorbed-x-YOLO-x-JEPA: data, model weights, training outputs (not source) ---
/data/
/runs/
/runs_jepa/
